# NUNCA use credenciais de produção nem comite valores reais.
# Variáveis da API KofLang (ambiente local / backend, não frontend).
MESCE_API_ENV=development
MESCE_AUTH0_ISSUER=https://SEU-TENANT.auth0.com/
MESCE_AUTH0_AUDIENCE=https://api.mesce.local
MESCE_AUTH0_JWKS_URL=https://SEU-TENANT.auth0.com/.well-known/jwks.json
# Use exclusivamente a string da branch Neon mesce-dev-2026-11 com SSL.
MESCE_DATABASE_URL=postgresql://usuario:senha@host-dev/neondb?sslmode=require
# Hex de 32 bytes aleatórios: nunca compartilhe a chave.
MESCE_DATA_KEY_HEX=SUBSTITUA_POR_64_CARACTERES_HEXADECIMAIS
