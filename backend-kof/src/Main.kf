// MESCE API — KofLang JVM, Auth0 RS256/JWKS e Neon PostgreSQL.
// Não expor na internet antes da prova de compilação e testes 401/403.
// Nenhum usuário tem acesso sem vínculo explícito em mesce_dev.actors.
record ActorRole(String role)
record NewMinister(String name, String phone)
record EncryptedMinister(String id, String name_ciphertext, String phone_ciphertext)
record MinisterResponse(String id, String name, String phone)
record NewAssisted(String name, String address, String phone)
record EncryptedAssisted(String id, String name_ciphertext, String address_ciphertext, String phone_ciphertext)
record AssistedResponse(String id, String name, String address, String phone)
record CelebrationRow(String id, String occurs_on, String starts_at, String location_code, String kind, Int required_ministers)
record NewCelebration(String occursOn, String startsAt, String locationCode, String kind, Int requiredMinisters)

main() {
    var environment = secrets.get("MESCE_API_ENV")
    var issuer = secrets.get("MESCE_AUTH0_ISSUER")
    var audience = secrets.get("MESCE_AUTH0_AUDIENCE")
    var jwksUrl = secrets.get("MESCE_AUTH0_JWKS_URL")
    var dbUrl = secrets.get("MESCE_DATABASE_URL")
    var dataKey = secrets.get("MESCE_DATA_KEY_HEX")

    if (environment != "development" || issuer == "" || audience == "" || jwksUrl == "" || dbUrl == "" || dataKey == "") {
        println("MESCE: configuração obrigatória ausente; API não iniciada.")
        return
    }

    // Kof JVM valida assinatura RS256 por JWKS, iss, aud e exp.
    var configured = auth.resourceServer(jwksUrl, issuer, audience)
    if (!configured) {
        println("MESCE: verificação de identidade indisponível; API não iniciada.")
        return
    }

    var database = db.connect(dbUrl)
    var app = web.app()
    var policy = mapOf()
    policy.put("auth", true)
    app.security(policy)

    // Toda a API exige Bearer access token verificado.
    app.get("/api/me") {
        var roles = db.query<ActorRole>(database, "SELECT role FROM mesce_dev.actors WHERE auth0_sub = ? AND active = true", auth.user())
        if (roles.size == 0) {
            return status(403, "{\"error\":\"access_denied\"}")
        }
        return json.encode(roles.get(0))
    }

    // Apenas coordenador, nunca retornar colunas cifradas em bruto.
    app.get("/api/ministers") {
        var roles = db.query<ActorRole>(database, "SELECT role FROM mesce_dev.actors WHERE auth0_sub = ? AND active = true", auth.user())
        if (roles.size == 0 || roles.get(0).role != "COORDINATOR") {
            return status(403, "{\"error\":\"forbidden\"}")
        }

        var encrypted = db.query<EncryptedMinister>(database, "SELECT id::text AS id, name_ciphertext, phone_ciphertext FROM mesce_dev.ministers WHERE active = true ORDER BY created_at")
        var result = listOf<MinisterResponse>()
        var index = 0
        while (index < encrypted.size) {
            var item = encrypted.get(index)
            var name = crypto.decryptAesGcm(item.name_ciphertext, dataKey)
            var phone = ""
            if (item.phone_ciphertext != null && item.phone_ciphertext != "") {
                phone = crypto.decryptAesGcm(item.phone_ciphertext, dataKey)
            }
            result.add(MinisterResponse(item.id, name, phone))
            index = index + 1
        }
        return json.encode(result)
    }

    // Um cadastro identificado só pode ser criado pelo coordenador.
    app.post("/api/ministers") {
        var roles = db.query<ActorRole>(database, "SELECT role FROM mesce_dev.actors WHERE auth0_sub = ? AND active = true", auth.user())
        if (roles.size == 0 || roles.get(0).role != "COORDINATOR") {
            return status(403, "{\"error\":\"forbidden\"}")
        }
        var input = json.decode<NewMinister>(body())
        if (input.name == "" || input.phone == "") {
            return status(400, "{\"error\":\"invalid_payload\"}")
        }
        var encryptedName = crypto.encryptAesGcm(input.name, dataKey)
        var encryptedPhone = crypto.encryptAesGcm(input.phone, dataKey)
        db.execute(database, "INSERT INTO mesce_dev.ministers(name_ciphertext, phone_ciphertext) VALUES(?, ?)", encryptedName, encryptedPhone)
        return status(201, "{\"created\":true}")
    }


    // Assistidos: somente coordenação; nunca disponibilizar endereço a usuários gerais.
    app.get("/api/assisted") {
        var roles = db.query<ActorRole>(database, "SELECT role FROM mesce_dev.actors WHERE auth0_sub = ? AND active = true", auth.user())
        if (roles.size == 0 || roles.get(0).role != "COORDINATOR") {
            return status(403, "{\"error\":\"forbidden\"}")
        }
        var encrypted = db.query<EncryptedAssisted>(database, "SELECT id::text AS id, name_ciphertext, address_ciphertext, phone_ciphertext FROM mesce_dev.assisted_people WHERE active = true ORDER BY created_at")
        var result = listOf<AssistedResponse>()
        var index = 0
        while (index < encrypted.size) {
            var item = encrypted.get(index)
            var name = crypto.decryptAesGcm(item.name_ciphertext, dataKey)
            var address = crypto.decryptAesGcm(item.address_ciphertext, dataKey)
            var phone = ""
            if (item.phone_ciphertext != null && item.phone_ciphertext != "") {
                phone = crypto.decryptAesGcm(item.phone_ciphertext, dataKey)
            }
            result.add(AssistedResponse(item.id, name, address, phone))
            index = index + 1
        }
        return json.encode(result)
    }

    app.post("/api/assisted") {
        var roles = db.query<ActorRole>(database, "SELECT role FROM mesce_dev.actors WHERE auth0_sub = ? AND active = true", auth.user())
        if (roles.size == 0 || roles.get(0).role != "COORDINATOR") {
            return status(403, "{\"error\":\"forbidden\"}")
        }
        var input = json.decode<NewAssisted>(body())
        if (input.name == "" || input.address == "") {
            return status(400, "{\"error\":\"invalid_payload\"}")
        }
        var name = crypto.encryptAesGcm(input.name, dataKey)
        var address = crypto.encryptAesGcm(input.address, dataKey)
        var phone = crypto.encryptAesGcm(input.phone, dataKey)
        db.execute(database, "INSERT INTO mesce_dev.assisted_people(name_ciphertext,address_ciphertext,phone_ciphertext) VALUES(?,?,?)", name, address, phone)
        return status(201, "{\"created\":true}")
    }

    // Celebrações: leitura por ministro vinculado, mutações somente coordenador.
    app.get("/api/celebrations") {
        var roles = db.query<ActorRole>(database, "SELECT role FROM mesce_dev.actors WHERE auth0_sub = ? AND active = true", auth.user())
        if (roles.size == 0) {
            return status(403, "{\"error\":\"forbidden\"}")
        }
        var events = db.query<CelebrationRow>(database, "SELECT id::text AS id, occurs_on::text AS occurs_on, starts_at::text AS starts_at, location_code, kind, required_ministers::int AS required_ministers FROM mesce_dev.celebrations ORDER BY occurs_on, starts_at")
        return json.encode(events)
    }

    app.post("/api/celebrations") {
        var roles = db.query<ActorRole>(database, "SELECT role FROM mesce_dev.actors WHERE auth0_sub = ? AND active = true", auth.user())
        if (roles.size == 0 || roles.get(0).role != "COORDINATOR") {
            return status(403, "{\"error\":\"forbidden\"}")
        }
        var input = json.decode<NewCelebration>(body())
        if (input.kind == "" || input.locationCode == "" || input.requiredMinisters < 1 || input.requiredMinisters > 30) {
            return status(400, "{\"error\":\"invalid_payload\"}")
        }
        // Um JSON vinculável evita depender de overload com cinco parâmetros.
        db.execute(database, "WITH payload AS (SELECT ?::jsonb AS j) INSERT INTO mesce_dev.celebrations(occurs_on,starts_at,location_code,kind,required_ministers) SELECT (j->>'occursOn')::date, (j->>'startsAt')::time, j->>'locationCode', j->>'kind', (j->>'requiredMinisters')::smallint FROM payload", json.encode(input))
        return status(201, "{\"created\":true}")
    }

    // Processo de desenvolvimento: restringir acesso pela rede/firewall. Nunca publicar sem TLS, CORS e auditoria.
    app.listen(8081)
}
